# ==========================================
# 1. BASE DE DONNEES COMMUNE (MySQL 8.0)
# ==========================================
DB_HOST=db-commune
DB_PORT=3306
DB_NAME=gestion_flotte
DB_USER=root
DB_ROOT_PASSWORD=changez_moi

# ==========================================
# 2. PORTS DES 4 MICROSERVICES
# ==========================================
VEHICULE_PORT=8001
CHAUFFEUR_PORT=8002
CARBURANT_PORT=8003
ENTRETIEN_PORT=8004

# ==========================================
# 3. ADRESSES IP DES 4 PC (mettre l'IPv4 de chaque PC, "ipconfig")
# ==========================================
IP_PC_VEHICULE=127.0.0.1
IP_PC_CHAUFFEUR=127.0.0.1
IP_PC_CARBURANT=127.0.0.1
IP_PC_ENTRETIEN=127.0.0.1

# ==========================================
# 4. URLs DE COMMUNICATION INTER-SERVICES
# ==========================================
VEHICULE_SERVICE_URL=http://${IP_PC_VEHICULE}:${VEHICULE_PORT}
CHAUFFEUR_SERVICE_URL=http://${IP_PC_CHAUFFEUR}:${CHAUFFEUR_PORT}
CARBURANT_SERVICE_URL=http://${IP_PC_CARBURANT}:${CARBURANT_PORT}
ENTRETIEN_SERVICE_URL=http://${IP_PC_ENTRETIEN}:${ENTRETIEN_PORT}

# ==========================================
# 5. AUTHENTIFICATION (identique dans TOUS les services)
# Demander la vraie valeur a l'equipe (ne pas la commiter)
# ==========================================
JWT_SECRET=changez_moi_16_caracteres_minimum
SERVICE_API_KEY=changez_moi

# ==========================================
# 6. ENTRETIEN
# ==========================================
ENTRETIEN_DB_NAME=entretien_db
# Port MySQL expose sur la machine (changer si 3306 est deja pris)
DB_HOST_PORT=3306
