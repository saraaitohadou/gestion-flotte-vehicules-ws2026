APP_NAME="Service Entretien"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004
APP_LOCALE=fr
APP_TIMEZONE=Africa/Casablanca

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base commune gestion_flotte : choix architectural assumé avec Véhicule et Chauffeur.
# Ne pas créer entretien_db. En stack racine, le nom est piloté par ENTRETIEN_DB_NAME.
DB_CONNECTION=mysql
DB_HOST=db-commune
DB_PORT=3306
DB_DATABASE=gestion_flotte
DB_USERNAME=root
DB_PASSWORD=rootpassword
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Service Véhicule (source de vérité unique : config/vehicule.php) ---
VEHICULE_CHECK=true
VEHICULE_SERVICE_URL=http://localhost:8001
VEHICULE_API_PREFIX=/api
VEHICULE_SERVICE_TIMEOUT=3
SERVICE_API_KEY=

# --- Saga Véhicule : tentatives avant dead-letter (défaut 3) ---
SYNCHRONISATION_TENTATIVES_MAX=3

# --- Service Chauffeur (stack racine) ---
CHAUFFEUR_SERVICE_URL=http://chauffeur-service:8000
CHAUFFEUR_API_PREFIX=/api
CHAUFFEUR_SERVICE_TIMEOUT=3

# --- Service Carburant (statistiques en lecture seule) ---
CARBURANT_SERVICE_URL=http://carburant-service:8000
CARBURANT_API_PREFIX=
CARBURANT_SERVICE_TIMEOUT=3
JWT_SECRET=changez_moi_16_caracteres_minimum
