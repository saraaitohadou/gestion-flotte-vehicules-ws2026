<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <source>
        <include><directory>app</directory></include>
    </source>
    <php>
        <!-- force="true" : les tests ne touchent JAMAIS la base MySQL de Docker.
             Les entrées <server> sont nécessaires en plus de <env> car Laravel lit
             $_SERVER en priorité : sans elles, un DB_CONNECTION=mysql injecté par
             docker-compose resterait actif pendant les tests. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="JWT_SECRET" value="secret-de-test-0123456789-0123456789" force="true"/>
        <env name="VEHICULE_SERVICE_URL" value="http://vehicule.test" force="true"/>

        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="JWT_SECRET" value="secret-de-test-0123456789-0123456789" force="true"/>
        <server name="VEHICULE_SERVICE_URL" value="http://vehicule.test" force="true"/>
    </php>
</phpunit>
